{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "thinkcode",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "thinkcode"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "thinkcode-db",
			// Created with `wrangler d1 create thinkcode-db`. This ID is safe to
			// commit: it is a resource identifier, not a credential. The API token
			// that talks to it lives in the environment (and in the repo's GitHub
			// secrets), never in this file.
			"database_id": "a5361ce7-0ea3-433d-a2ff-9c87332585b5"
		}
	]
}